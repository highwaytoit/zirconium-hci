#!/bin/bash
set -xeuo pipefail

install -Dpm0644 -t /usr/share/flatpak/remotes.d/ "$SRCDIR/cache/flathub.flatpakrepo"

(
    strata_cache="$SRCDIR/cache/strata/$ARCHITECTURE"
    strata_archive=$(cat "$strata_cache/release")
    case "$ARCHITECTURE" in
        x86-64) strata_target=x86_64-unknown-linux-gnu ;;
        arm64) strata_target=aarch64-unknown-linux-gnu ;;
        *) echo "Unsupported Strata architecture: $ARCHITECTURE" >&2; exit 1 ;;
    esac
    if [[ ! $strata_archive =~ ^strata-(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)-${strata_target}\.tar\.gz$ ]]; then
        echo "Unexpected cached Strata archive name: $strata_archive" >&2
        exit 1
    fi
    (cd "$strata_cache" && sha256sum --check --strict "$strata_archive.sha256")

    strata_tmp=$(mktemp -d)
    trap 'rm -rf "$strata_tmp"' EXIT
    tar --extract --gzip --file="$strata_cache/$strata_archive" --directory="$strata_tmp" \
        --no-same-owner --no-same-permissions
    strata_extracted="$strata_tmp/${strata_archive%.tar.gz}"
    test -x "$strata_extracted/strata"
    test -f "$strata_extracted/io.github.lgse.Strata.desktop"
    test -f "$strata_extracted/io.github.lgse.Strata.svg"

    install -Dm0755 "$strata_extracted/strata" /usr/bin/strata
    install -Dm0644 "$strata_extracted/io.github.lgse.Strata.desktop" /usr/share/applications/io.github.lgse.Strata.desktop
    install -Dm0644 "$strata_extracted/io.github.lgse.Strata.svg" /usr/share/icons/hicolor/scalable/apps/io.github.lgse.Strata.svg
    update-desktop-database /usr/share/applications
    gtk-update-icon-cache -qtf /usr/share/icons/hicolor
)

niri --version | grep -i -E "niri [[:digit:]]*\.[[:digit:]]*"

install -d /usr/share/zirconium/
sed --sandbox -i -e '/gnome_keyring.so/ s/-auth/auth/ ; /gnome_keyring.so/ s/-session/session/' /etc/pam.d/greetd
install -d /usr/share/bash-completion/completions /usr/share/zsh/site-functions /usr/share/fish/vendor_completions.d/
just --completions bash | sed -E 's/([\(_" ])just/\1zjust/g' > /usr/share/bash-completion/completions/zjust
just --completions zsh | sed -E 's/([\(_" ])just/\1zjust/g' > /usr/share/zsh/site-functions/_zjust
just --completions fish | sed -E 's/([\(_" ])just/\1zjust/g' > /usr/share/fish/vendor_completions.d/zjust.fish

ln -s "/usr/share/fonts/google-noto-sans-cjk-fonts" "/usr/share/fonts/noto-cjk"

fc-cache --force --really-force --system-only --verbose # recreate font-cache to pick up the added fonts

# These files NEED to be on the image.
test -x /usr/bin/strata
test -f /usr/share/applications/io.github.lgse.Strata.desktop
test -f /usr/share/icons/hicolor/scalable/apps/io.github.lgse.Strata.svg
grep -F -e "Comment=Central repository of Flatpak applications" /usr/share/flatpak/remotes.d/flathub.flatpakrepo
stat /usr/share/flatpak/remotes.d/flathub.flatpakrepo
stat /usr/bin/luks*tpm*
stat /usr/share/zirconium/just/00-start.just
# Not yet, needs a lot of fixes for sysupdate version
# stat /usr/bin/taidan
# stat /usr/lib/systemd/system/taidan*.service

ln -s fedora-release /usr/lib/system-release


(
    . /usr/lib/os-release
    IMAGE_NAME="zirconium"
    HOME_URL="https://github.com/zirconium-dev/zirconium"

    tee /usr/lib/os-release <<EOF
NAME="${IMAGE_NAME^}"
ID="${IMAGE_NAME}"
ID_LIKE="$ID"
PRETTY_NAME="${IMAGE_NAME^}"
FANCY_NAME="\033[0;38:2:252:186:3;1;49m⸭\033[0;38:2:252:186:3;49m ${IMAGE_NAME^} \033[0m"
VERSION="$VERSION"
VERSION_ID="$VERSION_ID"
VERSION_CODENAME="Pibble"
ANSI_COLOR="38:2:252:186:3;1;49"
ANSI_COLOR_REVERSE="48;2;252;186;3;1;30"
LOGO="${IMAGE_NAME}"
HOME_URL="${HOME_URL}"
BUG_REPORT_URL="${HOME_URL}/issues"
SUPPORT_URL=\"${HOME_URL}/issues
CPE_NAME="cpe:/o:${IMAGE_NAME}-dev:${IMAGE_NAME}"
DOCUMENTATION_URL="${HOME_URL}"
DEFAULT_HOSTNAME="${IMAGE_NAME}-????-????"
EOF

    tee /usr/lib/issue <<EOF
\e[0;38:2:252:186:3;1;49m▒\e[0m \e[0;38:2:252:186:3;1;49m⸭\e[0;38:2:252:186:3;49m ${IMAGE_NAME^} \e[0m
\e[0;38:2:252:186:3;1;49m▒\e[0m Kernel \r on an \m (\l)

EOF
)
