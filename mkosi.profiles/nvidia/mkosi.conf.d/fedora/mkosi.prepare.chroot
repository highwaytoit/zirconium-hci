#!/usr/bin/env bash

set -xeuo pipefail

mkdir -p "${SRCDIR}/cache"
pushd "${SRCDIR}/cache"
cp "${SRCDIR}/mkosi.sandbox/usr/share/dnf5/repos.d/negativo-17-multimedia.repo" /usr/share/dnf5/repos.d/
dnf download dkms-nvidia --repo=fedora-multimedia "--arch=noarch" "--destdir=${SRCDIR}/cache"
find . -iname "dkms-nvidia*.rpm"
rm /usr/share/dnf5/repos.d/negativo-17-multimedia.repo
popd

rpm -i "${SRCDIR}/cache/*dkms-nvidia*.rpm" --noscripts --nodeps
