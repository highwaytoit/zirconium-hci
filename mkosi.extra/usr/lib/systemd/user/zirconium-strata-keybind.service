[Unit]
Description=Set up the initial Zirconium Strata shortcut
After=chezmoi-init.service systemd-tmpfiles-setup.service dms.service
PartOf=graphical-session.target

[Service]
Type=oneshot
ExecStart=/usr/bin/python3 /usr/share/zirconium/strata/setup-keybind.py
TimeoutStartSec=60

[Install]
WantedBy=graphical-session.target
